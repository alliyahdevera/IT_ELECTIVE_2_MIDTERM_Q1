@model MusicPlaylist.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="container">
        <div class="row align-items-center g-4">

            <div class="col-lg-7">
                <p class="hero-label">
                    YOUR MUSIC, YOUR PLAYLIST
                </p>

                <h1 class="hero-title">
                    Welcome, @Model.ProfileName!
                </h1>

                <p class="hero-description">
                    Search for your favorite music, create your own
                    playlist, and discover the most-played songs
                    from all profiles.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Music"
                       asp-action="Search"
                       class="btn btn-primary-custom">
                        Search Music
                    </a>

                    <a asp-controller="Playlist"
                       asp-action="Index"
                       class="btn btn-outline-custom">
                        My Playlist
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="music-visual">
                    <div class="music-icon">
                        <i class="bi bi-music-note-beamed"></i>
                    </div>

                    <h3>Play your favorites</h3>

                    <p>
                        Add music videos from YouTube and listen
                        to them through your personal playlist.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="statistics-section">
    <div class="container">
        <div class="row g-4">

            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-people"></i>

                    <div>
                        <h3>@Model.TotalProfiles</h3>
                        <p>Total Profiles</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-music-note-list"></i>

                    <div>
                        <h3>@Model.TotalSongs</h3>
                        <p>Available Songs</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-play-circle"></i>

                    <div>
                        <h3>@Model.TotalStreams</h3>
                        <p>Total Plays</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="top-songs-section">
    <div class="container">

        <div class="section-heading">
            <div>
                <p class="section-label">
                    TRENDING NOW
                </p>

                <h2>Top 5 Most Played Songs</h2>

                <p>
                    Based on the total number of plays from all profiles.
                </p>
            </div>
        </div>

        @if (Model.TopSongs.Count == 0)
        {
            <div class="empty-ranking">
                <i class="bi bi-bar-chart"></i>

                <h3>No song rankings yet</h3>

                <p>
                    Play songs from your playlist to create the
                    Top 5 ranking.
                </p>

                <a asp-controller="Music"
                   asp-action="Search"
                   class="btn btn-primary-custom">
                    Find Music
                </a>
            </div>
        }
        else
        {
            <div class="top-song-list">

                @for (int index = 0;
               index < Model.TopSongs.Count;
               index++)
                {
                    var song = Model.TopSongs[index];

                    <div class="top-song-card">

                        <div class="rank-number">
                            @(index + 1)
                        </div>

                        <img src="@song.ThumbnailUrl"
                             alt="@song.Title"
                             class="song-thumbnail" />

                        <div class="song-details">
                            <h4>@song.Title</h4>

                            <p>@song.ChannelTitle</p>
                        </div>

                        <div class="play-count">
                            <i class="bi bi-play-fill"></i>

                            <span>
                                @song.PlayCount
                                @(song.PlayCount == 1 ? "play" : "plays")
                            </span>
                        </div>

                    </div>
                }

            </div>
        }

    </div>
</section>