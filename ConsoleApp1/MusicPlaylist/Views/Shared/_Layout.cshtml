@using Microsoft.AspNetCore.Http

@{
    string? profileName =
        Context.Session.GetString("ProfileName");

    int? profileId =
        Context.Session.GetInt32("ProfileId");

    bool isLoggedIn = profileId != null;
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Music Playlist</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="navbar-brand">
                    <i class="bi bi-music-note-beamed"></i>
                    MusicSpace
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    @if (isLoggedIn)
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center">

                            <li class="nav-item">
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="nav-link">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Music"
                                   asp-action="Search"
                                   class="nav-link">
                                    Search Music
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Playlist"
                                   asp-action="Index"
                                   class="nav-link">
                                    My Playlist
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Profile"
                                   asp-action="Index"
                                   class="nav-link">
                                    Profile
                                </a>
                            </li>

                            <li class="nav-item dropdown">

                                <button class="nav-link dropdown-toggle profile-menu"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <i class="bi bi-person-circle"></i>

                                    @(string.IsNullOrWhiteSpace(profileName)
                                        ? "Profile"
                                        : profileName)
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a asp-controller="Profile"
                                           asp-action="Index"
                                           class="dropdown-item">
                                            <i class="bi bi-person"></i>
                                            View Profile
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i>
                                                Logout
                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </li>

                        </ul>
                    }
                    else
                    {
                        <div class="ms-auto">
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-primary-custom">
                                Login
                            </a>
                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="footer-content">

                <div>
                    <strong>MusicSpace</strong>

                    <p>
                        Create and enjoy your personal music playlist.
                    </p>
                </div>

                <div>
                    <p>
                        ASP.NET Core MVC Music Playlist Project
                    </p>
                </div>

            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
            "Scripts",
            required: false
            )

</body>

</html>