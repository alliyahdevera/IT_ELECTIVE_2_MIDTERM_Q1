@model List<MusicPlaylist.Models.PlaylistItem>

@{
    ViewData["Title"] = "My Playlist";

    var firstSong = Model.FirstOrDefault();
}

<div class="container py-5">

    <div class="d-flex flex-wrap
                justify-content-between
                align-items-center
                gap-3 mb-4">

        <div>
            <p class="section-label mb-1">
                MY MUSIC
            </p>

            <h1 class="fw-bold">
                My Playlist
            </h1>

            <p class="text-secondary mb-0">
                @Model.Count
                @(Model.Count == 1 ? "song" : "songs")
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Playlist"
               asp-action="Add"
               class="btn btn-primary-custom">
                <i class="bi bi-plus-circle"></i>
                Add YouTube Song
            </a>

            @if (Model.Count > 0)
            {
                <form asp-controller="Playlist"
                      asp-action="Clear"
                      method="post"
                      onsubmit="return confirm('Clear your playlist?');">

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Clear
                    </button>

                </form>
            }

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center
                    border border-secondary
                    rounded-3 p-5">

            <i class="bi bi-music-note-list display-3"></i>

            <h2 class="h4 mt-3">
                Your playlist is empty
            </h2>

            <p class="text-secondary">
                Add a YouTube URL to start your playlist.
            </p>

            <a asp-controller="Playlist"
               asp-action="Add"
               class="btn btn-primary-custom">
                Add Song
            </a>

        </div>
    }
    else
    {
        <div class="card bg-dark
                    text-light
                    border-secondary
                    mb-4">

            <div class="card-body p-3 p-md-4">

                <h2 id="currentSongTitle"
                    class="h4 fw-bold mb-3">
                    @firstSong!.Title
                </h2>

                <div class="ratio ratio-16x9">

                    <iframe id="youtubeFrame"
                            src="@firstSong.EmbedUrl"
                            title="@firstSong.Title"
                            allow="accelerometer;
                                   autoplay;
                                   clipboard-write;
                                   encrypted-media;
                                   gyroscope;
                                   picture-in-picture;
                                   web-share"
                            allowfullscreen>
                    </iframe>

                </div>

            </div>
        </div>

        <div class="d-flex flex-column gap-3">

            @foreach (var song in Model)
            {
                <div class="card bg-dark
                            text-light
                            border-secondary">

                    <div class="card-body">

                        <div class="row
                                    align-items-center
                                    g-3">

                            <div class="col">

                                <h3 class="h6 fw-bold mb-1">
                                    @song.Title
                                </h3>

                                <a href="@song.YouTubeUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="small text-secondary">
                                    View on YouTube
                                </a>

                            </div>

                            <div class="col-md-auto">

                                <div class="d-flex gap-2">

                                    <button type="button"
                                            class="btn btn-primary-custom"
                                            onclick="playSong(
                                                '@song.VideoId',
                                                '@Html.Raw(
                                                    System.Text.Encodings.Web
                                                        .JavaScriptEncoder
                                                        .Default
                                                        .Encode(song.Title)
                                                )'
                                            )">

                                        <i class="bi bi-play-fill"></i>
                                        Play
                                    </button>

                                    <form asp-controller="Playlist"
                                          asp-action="Remove"
                                          method="post">

                                        <input type="hidden"
                                               name="videoId"
                                               value="@song.VideoId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger"
                                                onclick="return confirm(
                                                    'Remove this song?'
                                                );">

                                            <i class="bi bi-trash"></i>
                                            Remove
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@section Scripts {
    <script>
        function playSong(videoId, title) {
            const iframe =
                document.getElementById("youtubeFrame");

            const titleElement =
                document.getElementById("currentSongTitle");

            iframe.src =
                "https://www.youtube.com/embed/" +
                encodeURIComponent(videoId) +
                "?autoplay=1";

            titleElement.textContent = title;

            recordPlay(videoId);

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });
        }

        function recordPlay(videoId) {
            const body =
                new URLSearchParams();

            body.append("videoId", videoId);

            fetch('@Url.Action("RecordPlay", "Home")', {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/x-www-form-urlencoded"
                },

                credentials: "same-origin",

                body: body.toString()
            })
            .catch(error => {
                console.error(error);
            });
        }
    </script>
}